# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# Google OAuth2 credentials
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Where Google redirects after OAuth consent
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend URL (for post-login redirect)
FRONTEND_URL=http://localhost:5173

# Secret used to sign JWT access tokens (generate with: openssl rand -hex 32)
SECRET_KEY=changeme_generate_a_real_secret_key

# SQLite DB path (relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./email_aggregator.db

# Token lifetimes (seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=2592000
